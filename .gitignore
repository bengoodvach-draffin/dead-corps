# OS-generated metadata (macOS Finder / Windows Explorer)
.DS_Store
Thumbs.db

# Godot 4+ specific ignores
.godot/
.nomedia

# Purchased art assets (itch.io license forbids redistribution; repo is public,
# so the ENTIRE art tree stays local — raw packs AND the curated in-game subset).
# If the repo ever goes private, /art/units, /art/tiles, /art/fx may be tracked again.
/art/

# Exported builds — never commit binaries (export_presets.cfg writes the .exe to repo root)
/Exports/
*.exe
*.pck

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json
