[sub_resource type="GDScript" id="GDScript_driver"]
script/source = "extends Node

## Throwaway measurement driver (cursor-precision bug hunt): orders the zombie
## +200px right, logs its CLOSEST approach to the target every half second.

var fired := false
var t := 0.0
var target := Vector2.ZERO
var z: Node2D = null
var min_gap := INF
var next_log := 0.0

func _physics_process(delta: float) -> void:
	t += delta
	if not fired and t > 1.5:
		fired = true
		z = get_tree().get_first_node_in_group(\"zombies\")
		target = z.global_position + Vector2(200, 0)
		z.set_move_target(target)
		print(\"MOVETEST order: \", z.global_position.round(), \" -> \", target.round())
	if fired and z != null:
		min_gap = minf(min_gap, z.global_position.distance_to(target))
		if t > next_log:
			next_log = t + 0.5
			print(\"MOVETEST t=%.1f pos=%s gap_now=%.2f min_gap=%.2f\" % [t, z.global_position.round(), z.global_position.distance_to(target), min_gap])
"

